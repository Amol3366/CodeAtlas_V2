# CodeAtlas environment configuration example.
# Copy to `.env` (git-ignored) and fill in only what you need.
# CodeAtlas is local-first: NONE of these are required for core operation.

# --- Optional cloud providers (explicit opt-in only) ---
# Leave blank/unset to keep CodeAtlas fully local and deterministic.
CODEATLAS_OPENAI_API_KEY=
CODEATLAS_OPENAI_BASE_URL=

# --- Optional local model runtime ---
# CODEATLAS_OLLAMA_BASE_URL=http://localhost:11434

# --- Data locations (defaults derive from %LOCALAPPDATA%\CodeAtlas) ---
# CODEATLAS_DATA_DIR=
# CODEATLAS_VECTORS_DIR=
# CODEATLAS_CACHE_DIR=

# --- Provider enablement flags (default: everything off / deterministic) ---
CODEATLAS_EMBEDDINGS_ENABLED=false
CODEATLAS_ANSWERING_ENABLED=false
